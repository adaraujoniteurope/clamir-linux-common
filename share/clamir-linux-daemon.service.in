[Unit]
Description=Clamir Linux Daemon Service
After=network-online.target

[Service]
StandardOutput=syslog
StandardError=syslog
Environment="CONFIGURATION_DIRECTORY=/home/clamir/conf"
WorkingDirectory=/home/clamir/conf
ExecStartPre=/usr/bin/bash -c "mkdir -p /home/clamir/conf && chown -R clamir:clamir /home/clamir"
ExecStart=@CMAKE_INSTALL_PREFIX@/bin/clamir-linux-daemon
Restart=always

[Install]
WantedBy=multi-user.target