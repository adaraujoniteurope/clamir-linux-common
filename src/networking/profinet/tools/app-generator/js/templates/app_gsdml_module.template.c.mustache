APP_GSDML_MOD_{{module}}_SUBMODULES_TABLE(GSDML_SUBMODULE_DEFINE)

GSDML_MODULE(APP_GSDML_MOD_{{module}}_ID, app_gsdml_mod_{{module}}, "{{description}}", APP_GSDML_MOD_{{module}}_SUBMODULES_TABLE)

static unsigned char value[8] = {0};
static uint16_t value_size = sizeof(value);

{{#submodules}}
int app_gsdml_mod_{{module}}_submod_{{submodule}}_object_get(size_t submodule_id, void* data, uint16_t* size)
{
    data = &value;
    *size = value_size;
    return 0;
}

int app_gsdml_mod_{{module}}_submod_{{submodule}}_object_set(size_t submodule_id, void* data, uint16_t size)
{

    if (size != value_size)
    {
        return -1;
    }

    if (data == NULL)
    {
        return -1;
    }

    memcpy(value, data, sizeof(value));
    return 0;
}

{{#parameters}}
int app_gsdml_mod_{{module}}_submod_{{submodule}}_parameter_{{parameter}}_object_get(void* arg, void** data, uint16_t* size)
{
    return app_gsdml_default_param_get(arg, data, size);
}

int app_gsdml_mod_{{module}}_submod_{{submodule}}_parameter_{{parameter}}_object_set(void* arg, void* data, uint16_t size)
{
    return app_gsdml_default_param_set(arg, data, size);
}
